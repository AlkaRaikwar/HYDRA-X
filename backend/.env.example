# IBM watsonx.ai credentials
# Get these from IBM Cloud: https://cloud.ibm.com
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
PROJECT_ID=your_watsonx_project_id_here
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com

# Optional: override the Granite model ID
# GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# Backend port (default: 5000)
PORT=5000

# ⚠️  Without WATSONX_API_KEY and PROJECT_ID the app runs in DEMO MODE.
#     Demo mode uses rule-based triage and labelled demo data.
#     No credentials needed for the demo.
